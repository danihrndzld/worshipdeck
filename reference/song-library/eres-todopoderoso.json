  "sections": [
    {
      "type": "verse",
      "lines": [
        "LA ÚNICA RAZÓN DE MI ADORACIÓN",
        "ERES TÚ MI JESÚS"
      ],
      "chunk_size": "whole"
    },
    {
      "type": "verse",
      "lines": [
        "EL ÚNICO MOTIVO, PARA VIVIR ",
        "ERES TÚ MI SEÑOR"
      ],
      "chunk_size": "whole"
    },
    {
      "type": "verse",
      "lines": [
        "MI ÚNICA VERDAD, ESTÁ EN TI",
        "ERES MI LUZ Y MI SALVACIÓN"
      ],
      "chunk_size": "whole"
    },
    {
      "type": "verse",
      "lines": [
        "MI ÚNICO AMOR ERES TÚ SEÑOR",
        "Y POR SIEMPRE TE ALABARÉ"
      ],
      "chunk_size": "whole"
    },
    {
      "type": "verse",
      "lines": [
        "TÚ ERES TODOPODEROSO",
        "ERES GRANDE Y MAJESTUOSO"
      ],
      "chunk_size": "whole"
    },
    {
      "type": "verse",
      "lines": [
        "ERES FUERTE, INVENCIBLE",
        "Y NO HAY NADIE COMO TÚ"
      ],
      "chunk_size": "whole"
    },
